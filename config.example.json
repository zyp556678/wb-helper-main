{
  "_说明": "本文件是 config.json 的示例。网关**热加载**它：保存后 1 秒内自动生效（仅 server.read_timeout 需重启）。",
  "upstream": {
    "headerTimeoutSeconds": 300,
    "idleTimeoutSeconds": 120,
    "transientRetries": 2
  },
  "debug": {
    "enabled": false,
    "full_requests": false
  },
  "models": {
    "blocklist": [],
    "allowlist": [],
    "accounts": {}
  },
  "logging": {
    "request_archive_enabled": true,
    "request_retention_days": 7,
    "request_archive_max_mb": 100
  },
  "prompt": {
    "mode": "append",
    "text": "",
    "file": "",
    "sanitize": true,
    "degraded_retry": true,
    "strict_first_system": true
  },
  "local": {
    "enabled": true,
    "bin": "wb-local-agent",
    "data_dir": ""
  },
  "server": {
    "read_timeout": "300s"
  },
  "update": {
    "enabled": true,
    "check_hours": 6,
    "repo": "zyp556678/wb-helper-main",
    "include_prerelease": false,
    "token": ""
  },
  "schedule": {
    "include_disabled_in_tasks": false
  }
}
