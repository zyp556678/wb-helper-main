{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Gateway",
  "version": "0.9.0",
  "identifier": "com.workbuddy.gateway.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy 网关",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*",
      "WebView2Loader.dll"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
